# Comma-separated list of front-end origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000

# Free API keys. Leave both empty to run with the built-in mock response.
# Gemini: https://aistudio.google.com/apikey   Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Order providers are tried in; the next one is used on errors or rate limits
PROVIDER_ORDER=gemini,groq

# Model IDs change often, so they are configurable
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# Per-IP limit on /api/generate, to protect the free quotas
RATE_LIMIT_PER_MINUTE=10

# Postgres connection string (free: https://neon.tech). Leave empty to disable sharing.
DATABASE_URL=
# Per-IP limit on saving shared UIs
SAVE_RATE_LIMIT_PER_MINUTE=20
